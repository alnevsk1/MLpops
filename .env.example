# Backend Settings

# Базовые настройки Django
DEBUG=True
SECRET_KEY="your-secret-key-here"
ALLOWED_HOSTS=localhost,127.0.0.1,your_server_ip

# Ключ шифрования для HF токенов - должен быть 32-url-safe-base64 строкой
# Сгенерировать новый можно в консоли: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=your-fernet-key-here

# Настройки PostgreSQL
DB_ENGINE=django.db.backends.postgresql
DB_NAME=mlhub_db
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=db # or localhost if running without Docker
DB_PORT=5432

# Frontend Settings

# For production:
VITE_API_BASE_URL=http://your_server_ip:8000/api/v1
VITE_MEDIA_BASE_URL=http://your_server_ip:8000

# For local development:
# VITE_API_BASE_URL=http://localhost:8000/api/v1
# VITE_MEDIA_BASE_URL=http://localhost:8000
