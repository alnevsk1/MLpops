# Global Environment Configuration
# This file contains shared configuration for both backend and frontend

# Базовые настройки Django
DEBUG=True
SECRET_KEY="your-secret-key-here"
ALLOWED_HOSTS=localhost,127.0.0.1,185.255.179.198,mlhub_backend

# Настройки сервера
BACKEND_HOST=185.255.179.198
BACKEND_PORT=8000
API_VERSION=v1

# API URL для Frontend
VITE_API_BASE_URL=http://185.255.179.198:8000/api/v1

# Ключ шифрования (BYOK hf_token) - должен быть 32-url-safe-base64 строкой
FERNET_KEY=your-fernet-key-here

# Настройки PostgreSQL
DB_ENGINE=django.db.backends.postgresql
DB_NAME=mlhub_db
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=db
DB_PORT=5432
