# Backend Environment Configuration
# Copy this to .env and update with your values

# Базовые настройки Django
DEBUG=True
SECRET_KEY="your-secret-key-here"
ALLOWED_HOSTS=*,localhost,127.0.0.1

# Настройки сервера
BACKEND_HOST=your_ip
BACKEND_PORT=your_port
API_VERSION=v1

# Ключ шифрования (BYOK hf_token) - должен быть 32-url-safe-base64 строкой
# Сгенерировать новый можно в консоли: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=your-fernet-key-here

# Настройки PostgreSQL
DB_ENGINE=django.db.backends.postgresql
DB_NAME=mlhub_db
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=db or localhost
DB_PORT=5432
